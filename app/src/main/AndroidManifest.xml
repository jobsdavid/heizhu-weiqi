<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     围棋练习 TV — 应用清单
     目标设备：小米电视 S Pro Mini LED 2026（澎湃OS 3 / Android TV 形态）
     ============================================================ -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- TV 应用必须声明不依赖触摸屏，否则不被识别为 TV 应用 -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- 声明本应用为 Leanback(TV) 应用 -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <!-- 纯本地单机应用，不申请任何网络权限（战绩仅存本机） -->

    <application
        android:allowBackup="true"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.WeiqiTV">

        <!-- 唯一的 Activity：全局单 Activity + Compose 内部导航 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!--
                  两个类别都要声明，少一个就会「装了却找不到」：

                  · LEANBACK_LAUNCHER —— 标准 Android TV 启动器入口
                  · LAUNCHER           —— 小米/部分国产电视的「应用」列表按这个枚举

                  实测（小米电视 MiTV-MFFU0 / tvhome 4.8.413）：
                  只声明 LEANBACK_LAUNCHER 时，系统里按普通 LAUNCHER 查询返回
                  「No activity found」，应用在电视的「应用」页里根本不出现 ——
                  应用是装好的（installed=true/hidden=false），用户却找不到。

                  一个 intent-filter 里同时声明两个类别是合法的：
                  过滤器匹配要求「意图的类别是过滤器类别的子集」，
                  所以 MAIN+LEANBACK_LAUNCHER 和 MAIN+LAUNCHER 都能命中。
                -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
